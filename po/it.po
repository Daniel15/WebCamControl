#: WebCamControl.Gtk/OutOfRangeDialog.cs:90
msgid ""
"Some controls could not be reset. This is a bug with your webcam, NOT with "
"WebCamControl."
msgstr ""
"Alcuni controlli non possono essere ripristinati. Si tratta di un bug della "
"webcam, NON di WebCamControl."

#: WebCamControl.Gtk/SavePresetDialog.cs:67
msgid "New preset"
msgstr "Nuovo preset"

