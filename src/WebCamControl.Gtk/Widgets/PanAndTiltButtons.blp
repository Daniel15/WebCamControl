using Gtk 4.0;

template $PanAndTiltButtons : Grid {
  column-spacing: 4;
  row-spacing: 4;

  $PressAndHoldButton _up {
    tooltip-text: _('Up');
    icon-name: 'go-up';
    width-request: 50;
    height-request: 50;

    layout {
      row: '0';
      column: '1';
    }
  }

  $PressAndHoldButton _down {
    tooltip-text: _('Down');
    icon-name: 'go-down';
    width-request: 50;
    height-request: 50;

    layout {
      row: '1';
      column: '1';
    }
  }

  $PressAndHoldButton _left {
    tooltip-text: _('Left');
    icon-name: 'go-previous';
    width-request: 50;
    height-request: 50;

    layout {
      row: '1';
      column: '0';
    }
  }

  $PressAndHoldButton _right {
    tooltip-text: _('Right');
    icon-name: 'go-next';
    width-request: 50;
    height-request: 50;

    layout {
      row: '1';
      column: '2';
    }
  }
}
