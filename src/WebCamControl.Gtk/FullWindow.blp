using Gtk 4.0;
using Adw 1;

template $FullWindow : Adw.ApplicationWindow {
  title: _('WebCamControl');

  Adw.ToolbarView {
    content: Box {
      orientation: vertical;

      Adw.HeaderBar {
        title-widget: Box {
          Adw.ViewSwitcher {
            stack: stack;
            policy: wide;
          }
          Button {
            action-name: "app.toggle_view";
            icon-name: "view-restore-symbolic";
            tooltip-text: _("Switch to mini view (Ctrl+T)");
          }
        };
      }

      Adw.ViewStack stack {
        Adw.ViewStackPage {
          name: "camera";
          title: _("Camera");

          child: ListBox {
            styles [
              "boxed-list",
              "settings-page",
            ]

            Adw.ComboRow _cameraCombo {
              title: _("Camera");
            }
            
            Adw.ComboRow _resolutionCombo {
              title: _("Resolution");
              model: Gtk.StringList {
                // Dummy data for testing
                strings["3840x2160", "1920x1080"]
              };
            }
            
            Adw.ComboRow _frameRateCombo {
              title: _("Frame Rate");
              model: Gtk.StringList {
                // Dummy data for testing
                strings["60 fps", "30 fps"]
              };
            }
            
            Adw.ComboRow _pixelFormatCombo {
              title: _("Pixel Format");
              model: Gtk.StringList {
                // Dummy data for testing
                strings["H.264", "M-JPEG"]
              };
            }
          };
        }
        
        Adw.ViewStackPage {
          name: "image";
          title: _("Image");

          child: ListBox _controls {
            styles [
              "boxed-list",
              "settings-page",
            ]
            
            Adw.ActionRow _panAndTiltRow {
              title: _("Pan and Tilt");
              selectable: false;
              
              [suffix]
              Box _panAndTiltButtons {
                margin-bottom: 4;
                margin-top: 4;
              }
            }

            Adw.ActionRow _exampleRow {
              title: _("Brightness");

              [suffix]
              Scale _brightness {
                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 100;
                  value: 15;
                };

                orientation: horizontal;
                halign: fill;
                hexpand: true;
              }
            }
          };
        }
        
        Adw.ViewStackPage {
          name: "presets";
          title: _("Presets");
          child: ListBox _presetsList {
            styles [
              "boxed-list",
              "settings-page",
            ]
          };
        }
      }
    };
  }
}
